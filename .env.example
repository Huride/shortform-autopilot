# Copy to .env (chmod 600). Never commit the real file.

# ── LLM · TTS · images ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# LLM_PROVIDER=openai            # or anthropic (set ANTHROPIC_API_KEY)
# TTS_PROVIDER=openai            # openai | elevenlabs | stub (no audio, layout checks)

# ── YouTube (see docs/PLATFORM-SETUP.md §2) ────────────────────────
YOUTUBE_CLIENT_ID=....apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-...
YOUTUBE_REFRESH_TOKEN=1//...
# Uploads from un-audited API projects are locked private. Keep 'private'
# until your audit passes, then switch to 'public'.
YOUTUBE_PRIVACY_STATUS=private

# ── Instagram (see docs/PLATFORM-SETUP.md §3) ──────────────────────
IG_USER_ID=178...
IG_ACCESS_TOKEN=IGAA...          # long-lived (60d); the pipeline refreshes it daily
# IG_STORY=off                   # 'on' to also auto-post a story

# ── Storage: Cloudflare R2 / any S3-compatible (§4) ────────────────
S3_BUCKET=my-media
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
# OPS_PAGE_KEY=ops/daily.html    # use a hard-to-guess key in production
