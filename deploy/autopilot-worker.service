[Unit]
Description=Shortform Autopilot SaaS render worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=worker
WorkingDirectory=/home/worker/shortform-autopilot
# .env 는 src/config.ts 가 직접 읽는다 — EnvironmentFile 불필요
Environment=NODE_OPTIONS=
Environment=REMOTION_CHROME_MODE=chrome-for-testing
ExecStart=/usr/bin/npx tsx scripts/saas-worker.ts
Restart=always
RestartSec=10
# 렌더 중 종료 시 잡이 고아가 되지 않게 워커의 클레임 타임아웃이 회수한다
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
